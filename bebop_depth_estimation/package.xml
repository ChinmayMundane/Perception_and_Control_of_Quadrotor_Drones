<?xml version="1.0"?>
<package format="2">
  <name>bebop_depth_estimation</name>
  <version>0.1.0</version>
  <description>CPU and CUDA monocular metric depth and camera point clouds for Bebop ROS1 exercises.</description>
  <maintainer email="arcane@todo.todo">Arcane</maintainer>
  <license>BSD-3-Clause</license>
  <buildtool_depend>catkin</buildtool_depend>
  <exec_depend>rospy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>cv_bridge</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>bebop_description</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>xacro</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-opencv</exec_depend>
  <test_depend>python3-pytest</test_depend>
  <export/>
</package>

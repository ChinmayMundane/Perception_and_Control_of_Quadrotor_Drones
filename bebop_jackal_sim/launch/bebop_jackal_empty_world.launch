<?xml version="1.0"?>
<launch>
  <arg name="paused" default="false"/>
  <arg name="use_sim_time" default="true"/>
  <arg name="gui" default="true"/>
  <arg name="headless" default="false"/>
  <arg name="debug" default="false"/>
  <arg name="rviz" default="true"/>

  <arg name="bebop_x" default="-2.0"/>
  <arg name="bebop_y" default="0.0"/>
  <arg name="jackal_x" default="0.0"/>
  <arg name="jackal_y" default="0.0"/>

  <include file="$(find gazebo_ros)/launch/empty_world.launch">
    <arg name="paused" value="$(arg paused)"/>
    <arg name="use_sim_time" value="$(arg use_sim_time)"/>
    <arg name="gui" value="$(arg gui)"/>
    <arg name="headless" value="$(arg headless)"/>
    <arg name="debug" value="$(arg debug)"/>
  </include>

  <include file="$(find bebop_gazebo)/launch/spawn_bebop.launch">
    <arg name="x" value="$(arg bebop_x)"/>
    <arg name="y" value="$(arg bebop_y)"/>
  </include>

  <include file="$(find bebop_jackal_sim)/launch/spawn_jackal.launch">
    <arg name="x" value="$(arg jackal_x)"/>
    <arg name="y" value="$(arg jackal_y)"/>
  </include>

  <node pkg="bebop_gazebo" type="pcd_transform.py" name="pcd_tf_py"
        required="true" output="screen" if="$(arg rviz)"/>

  <node pkg="rviz" type="rviz" name="rviz"
        args="-d $(find bebop_jackal_sim)/rviz/bebop_jackal.rviz"
        if="$(arg rviz)"/>
</launch>
